<%@ Page Title="" Language="C#" MasterPageFile="admin.master" AutoEventWireup="true"
    CodeFile="send-sms.aspx.cs" Inherits="admin_send_sms" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="asp" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <title>Send SMS</title>
    <style type="text/css">
        .styless8
        {
            color: Black;
            width: 40%;
        }
        
        *
        {
            -webkit-text-size-adjust: none;
            height: -15px;
        }
        
        table, table tr, table td
        {
            border: none;
        }
        .styless9
        {
            width: 70px;
            font-weight: bold;
        }
    </style>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <div class="row" style="margin-top: 20px;">
        <div class="col-lg-12 mb-4">
            <div class="row" style="background: #F5BE6D;">
                <p style="color: #000; margin-top: 13px; font-size: 18px; padding-left: 14px;">
                    Send SMS
                </p>
            </div>
            <div class="row" style="background: #fff; padding: 15px 10px; border: 1px solid rgba(0, 0, 0, 0.15);
                border-bottom-right-radius: 3px !important; border-bottom-left-radius: 3px !important;">
                <div class="col-lg-12">
                    <asp:Label ID="Label1" runat="server" Text="" ForeColor="Green" Visible="false"></asp:Label>
                    <table class="styless8">
                        <tr>
                            <td class="styless9">
                                &nbsp;
                            </td>
                            <td>
                                <asp:ToolkitScriptManager ID="ToolkitScriptManager1" runat="server">
                                </asp:ToolkitScriptManager>
                            </td>
                        </tr>
                        <tr>
                            <td class="styless9">
                                &nbsp;Message:
                            </td>
                            <td>
                                <asp:TextBox ID="TextBox2" runat="server" Height="118px" TextMode="MultiLine"></asp:TextBox>
                                <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server" ControlToValidate="TextBox2"
                                    ErrorMessage="Enter Message" ForeColor="Red"></asp:RequiredFieldValidator>
                            </td>
                        </tr>
                        <tr>
                            <td class="styless9">
                                
                                &nbsp;Members:
                            </td>
                            <td>
                                
                                <asp:DropDownList ID="DropDownList1" runat="server" AutoPostBack="True" OnSelectedIndexChanged="DropDownList1_SelectedIndexChanged">
                                    <asp:ListItem>Individual</asp:ListItem>
                                    <asp:ListItem>All</asp:ListItem>
                                </asp:DropDownList>
                            </td>
                        </tr>
                        <tr runat="server" id="tdNumber">
                            <td class="styless9">
                                &nbsp;Number:
                            </td>
                            <td>
                                
                                <asp:TextBox ID="txtNo" runat="server"></asp:TextBox>
                                <span style="font-size: 11px; color: Blue">(Multiple numbers separated by comma)</span>
                            </td>
                        </tr>
                        <tr>
                            <td class="styless9">
                            </td>
                            <td>
                                <br />
                                <asp:Button ID="Button2" runat="server" CssClass="btn btn-primary" OnClick="Button2_Click"
                                    Text="Send " Style="margin-left: 50px" />
                                <asp:ConfirmButtonExtender ID="ConfirmButtonExtender1" runat="server" ConfirmOnFormSubmit="true"
                                    ConfirmText="Are you sure you want to send?" Enabled="True" TargetControlID="Button2">
                                </asp:ConfirmButtonExtender>
                                <br />
                            </td>
                        </tr>
                    </table>
                    <br />
                </div>
            </div>
        </div>
    </div>
</asp:Content>
