/* ===== Premium Member Dashboard Theme ===== */
:root {
    --navy: #17243b;
    --navy-light: #243955;
    --gold: #d6a84f;
    --page-bg: #f4f6fa;
    --text-main: #253247;
}

/* Main page */
body {
    background: var(--page-bg);
    color: var(--text-main);
    font-family: 'Nunito', Arial, sans-serif;
}

#content-wrapper {
    min-width: 0;
    background: var(--page-bg);
}

#content {
    min-width: 0;
}

/* Sidebar */
.sidebar {
    background: linear-gradient(180deg, #17243b 0%, #101a2c 100%)
        !important;
    box-shadow: 4px 0 20px rgba(16, 26, 44, .10);
}

.sidebar .sidebar-brand {
    min-height: 105px;
    padding: 16px 10px;
}

.sidebar .sidebar-brand-icon {
    transform: none !important;
}

.sidebar .sidebar-brand img {
    width: 76px !important;
    height: 76px !important;
    object-fit: contain;
}

.sidebar hr.sidebar-divider {
    border-top: 1px solid rgba(255,255,255,.12);
    margin: 12px 16px;
}

.sidebar p {
    margin: 8px 12px 18px !important;
    padding: 14px 12px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 12px;
    background: rgba(255,255,255,.055);
    color: #e8edf5;
    font-size: 12px !important;
    line-height: 1.9;
    overflow-wrap: anywhere;
}

.sidebar p span {
    color: #f0c979;
    font-weight: 700;
}

.sidebar .nav-item {
    margin: 3px 10px;
}

.sidebar .nav-item .nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 13px;
    border-radius: 9px;
    color: #d0d8e5;
    font-size: 13px;
    font-weight: 700;
    transition: background .2s ease, color .2s ease;
}

.sidebar .nav-item .nav-link i {
    width: 19px;
    min-width: 19px;
    color: #e0b45b !important;
    text-align: center;
    font-size: 14px;
}

.sidebar .nav-item .nav-link:hover,
.sidebar .nav-item.active > .nav-link {
    color: #fff;
    background: linear-gradient(100deg,
        rgba(214,168,79,.22), rgba(214,168,79,.07));
}

.sidebar .nav-item.active > .nav-link {
    border-left: 3px solid var(--gold);
}

.sidebar .collapse-inner {
    margin: 3px 0;
    border-radius: 10px !important;
    background: #fff !important;
    box-shadow: 0 8px 22px rgba(0,0,0,.12);
}

.sidebar .collapse-item {
    display: block;
    padding: 10px 13px;
    color: #344259 !important;
    font-size: 12px;
    border-radius: 6px;
}

.sidebar .collapse-item:hover {
    background: #fff6e4 !important;
    color: #8a641e !important;
}

/* Top navigation */
.topbar {
    min-height: 72px;
    padding: 10px 22px !important;
    background: #fff !important;
    border-bottom: 1px solid #e8ecf2;
    box-shadow: 0 3px 15px rgba(31,45,61,.04) !important;
}

.topbar .nav-link {
    color: #35435a !important;
}

.topbar .img-profile {
    width: 40px;
    height: 40px;
    border: 2px solid #f0d69e;
    object-fit: cover;
}

.topbar .dropdown-menu {
    border: 1px solid #edf0f5;
    border-radius: 12px;
    box-shadow: 0 12px 30px rgba(31,45,61,.12);
    padding: 8px;
}

.topbar .dropdown-item {
    padding: 10px 12px;
    border-radius: 7px;
    font-size: 13px;
}

/* Page content */
.container-fluid {
    padding: 22px 24px !important;
}

/* Consistent cards on dashboard and inner pages */
.card {
    border: 1px solid #edf0f5;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(31,45,61,.055);
}

.card-header {
    border-bottom: 1px solid #edf0f5;
    border-radius: 14px 14px 0 0 !important;
}

/* Forms */
.form-control,
.custom-select {
    min-height: 42px;
    border: 1px solid #dce2eb;
    border-radius: 8px;
    font-size: 13px;
}

.form-control:focus,
.custom-select:focus {
    border-color: #d6a84f;
    box-shadow: 0 0 0 3px rgba(214,168,79,.13);
}

.btn {
    border-radius: 8px;
    font-weight: 700;
}

.btn-primary {
    background: #243955;
    border-color: #243955;
}

.btn-primary:hover {
    background: #17243b;
    border-color: #17243b;
}

/* Tables */
.table-responsive {
    border-radius: 10px;
}

.table {
    color: #344259;
    font-size: 13px;
}

.table thead th {
    background: #f0f3f8;
    color: #263750;
    border-bottom: 1px solid #e1e6ef;
    font-weight: 800;
    white-space: nowrap;
}

.table td {
    vertical-align: middle;
}

/* Footer */
.sticky-footer {
    border-top: 1px solid #e8ecf2;
    background: #fff !important;
}

.sticky-footer .copyright {
    color: #7b8799;
    font-size: 12px;
}

/* Mobile and tablet */
@media (max-width: 767.98px) {
    .topbar {
        min-height: 60px;
        padding: 8px 12px !important;
    }

    .container-fluid {
        padding: 14px 10px !important;
    }

    #content-wrapper,
    #content {
        width: 100%;
        min-width: 0;
    }

    .sidebar .nav-item {
        margin: 3px 7px;
    }

    .sidebar p {
        font-size: 11px !important;
        padding: 10px 8px;
    }

    .card {
        margin-bottom: 14px;
    }

    .table {
        font-size: 12px;
    }

    .btn {
        max-width: 100%;
        white-space: normal;
    }
}

@media (max-width: 380px) {
    .container-fluid {
        padding: 10px 7px !important;
    }

    .topbar {
        padding: 7px 8px !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    .sidebar .nav-link {
        transition: none;
    }
}


    </style>
</head>
